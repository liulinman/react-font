{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "English World 阅读查词",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/freewing-16.png",
    "32": "icons/freewing-32.png",
    "48": "icons/freewing-48.png",
    "128": "icons/freewing-128.png"
  },
  "action": {
    "default_title": "连接 English World",
    "default_icon": {
      "16": "icons/freewing-16.png",
      "24": "icons/freewing-24.png",
      "32": "icons/freewing-32.png"
    }
  },
  "options_page": "options.html"
}
