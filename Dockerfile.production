# CI has already tested and built all sites. No package downloads on production.
FROM nginx:alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY apps/english-world/dist /usr/share/nginx/html
COPY apps/admin/dist /usr/share/nginx/html/admin
COPY apps/docs/dist /usr/share/nginx/html/docs
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
